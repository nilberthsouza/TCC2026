! ============================================================
!  OpenDSS - Modelo Teste (70 barras)
!  Convertido do formato MATLAB (caso.m)
!  Base: 100 MVA / 100 kV  ->  Z_base = 100 ohm
!
!  Estrutura do arquivo:
!    1. WireData  - dados fisicos dos condutores
!    2. LineCode  - tipos de cabo (8 grupos por X/R e nivel de tensao)
!    3. LineGeometry - geometria dos postes/torres por tipo
!    4. Lines     - ramos com LineCode + LineGeometry + Length equivalente
!    5. Loads     - cargas nas barras
! ============================================================

Clear

! --- Fonte slack na barra 1 ---
New Circuit.ModeleTeste
~ bus1=1
~ basekv=100
~ pu=1.0
~ angle=0
~ frequency=60
~ phases=3

! ============================================================
!  WIREDATA
!  Dados fisicos dos condutores (GMR, raio, ampacidade)
!  Parametros tipicos - ajuste conforme condutor real
!  normcode: unidades SI (raio/GMR em metros, Rac em ohm/km)
! ============================================================

! Cabo de Alumínio com Alma de Aço (CAA) - 636 kcmil GROSBEAK - transmissão AT
New WireData.CAA_GROSBEAK
~ Rac=0.0986      ! ohm/km a 50 Hz, 75 C
~ GMRac=0.00950   ! m
~ Radius=0.01415  ! m
~ normamps=600    ! A
~ emergamps=720   ! A

! CAA - 336 kcmil LINNET - ramal AT
New WireData.CAA_LINNET
~ Rac=0.1873
~ GMRac=0.00693
~ Radius=0.01029
~ normamps=400
~ emergamps=480

! Cabo de Alumínio (CA) 4 AWG - distribuição MT
New WireData.CA_4AWG
~ Rac=0.5280
~ GMRac=0.00330
~ Radius=0.00523
~ normamps=200
~ emergamps=240

! CA 2 AWG - distribuição MT média
New WireData.CA_2AWG
~ Rac=0.3320
~ GMRac=0.00416
~ Radius=0.00659
~ normamps=250
~ emergamps=300

! CA 6 AWG - ramal MT leve
New WireData.CA_6AWG
~ Rac=0.8380
~ GMRac=0.00261
~ Radius=0.00414
~ normamps=150
~ emergamps=180

! Cabo de Cobre (CU) 2 AWG - BT/MT R dominante
New WireData.CU_2AWG
~ Rac=0.3410
~ GMRac=0.00416
~ Radius=0.00659
~ normamps=130
~ emergamps=156

! CU 4 AWG - ramal resistivo
New WireData.CU_4AWG
~ Rac=0.5420
~ GMRac=0.00330
~ Radius=0.00523
~ normamps=100
~ emergamps=120

! Barra rigida de cobre (busbar)
New WireData.CU_BUSBAR
~ Rac=0.0100
~ GMRac=0.01000
~ Radius=0.01500
~ normamps=9999
~ emergamps=9999

! ============================================================
!  LINECODES
!  r1/x1 em ohm/km (parametros medianos de cada grupo)
!  c1=0 pois bshl=0 nos dados originais
!  Agrupamento por nivel de tensao e razao X/R:
!
!   LC_BARRAMENTO  : barramento rigido               X/R = 1.00
!   LC_AT_TRONCO   : tronco de transmissao AT        X/R = 2.40
!   LC_AT_RAMAL    : ramais de derivacao AT           X/R = 2.45
!   LC_MT_ALTA_R   : distribuicao MT condutor medio   X/R = 0.51
!   LC_MT_MEDIO    : distribuicao MT media            X/R = 1.17
!   LC_MT_LEVE     : ramal MT leve                    X/R = 1.22
!   LC_BT_R_DOM    : distribuicao BT/MT R dominante   X/R = 0.33
!   LC_RESISTIVA   : cabo essencialmente resistivo     X/R = 0.05
! ============================================================

New LineCode.LC_BARRAMENTO  nphases=3  r1=0.0006  x1=0.0006  c1=0  r0=0.0006  x0=0.0006  c0=0  units=km  normamps=9999  emergamps=9999
! Barramento rigido / conexao de barra (representa L3_4, Z = 0.0006+j0.0006 pu)

New LineCode.LC_AT_TRONCO   nphases=3  r1=0.0312  x1=0.0749  c1=0  r0=0.0936  x0=0.2246  c0=0  units=km  normamps=600   emergamps=720
! AT Tronco de transmissao - CAA Grosbeak, X/R=2.40
! Representa: L1_2, L2_3 (1.000 km cada), L4_5 (3.000 km)

New LineCode.LC_AT_RAMAL    nphases=3  r1=3.9931  x1=9.7644  c1=0  r0=11.9793 x0=29.2932 c0=0  units=km  normamps=400   emergamps=480
! AT Ramal de derivacao - CAA Linnet, X/R=2.45
! Representa: L3_29, L4_37, L5_48, L29_30, L37_38, L48_49, L49_50, L50_51

New LineCode.LC_MT_ALTA_R   nphases=3  r1=17.5510 x1=8.9408  c1=0  r0=52.6530 x0=26.8224 c0=0  units=km  normamps=200   emergamps=240
! MT distribuicao - CA 4AWG, X/R=0.51
! Representa: L6_7 a L9_10, L9_52, L10_54, L54_55..L56_57, L61_62, L63_64..L65_66

New LineCode.LC_MT_MEDIO    nphases=3  r1=4.5640  x1=5.3284  c1=0  r0=13.6920 x0=15.9852 c0=0  units=km  normamps=250   emergamps=300
! MT distribuicao media - CA 2AWG, X/R=1.17
! Representa: L5_6, L38_39..L43_44, L44_45..L45_46

New LineCode.LC_MT_LEVE     nphases=3  r1=0.0842  x1=0.1029  c1=0  r0=0.2526  x0=0.3087  c0=0  units=km  normamps=150   emergamps=180
! MT ramal leve - CA 6AWG, X/R=1.22
! Representa: L40_41, L46_47

New LineCode.LC_BT_R_DOM    nphases=3  r1=21.6065 x1=7.1439  c1=0  r0=64.8195 x0=21.4317 c0=0  units=km  normamps=100   emergamps=120
! BT/MT R dominante - CU 2AWG, X/R=0.33
! Representa: L10_11..L27_28, L30_31..L35_36, L52_53, L57_58..L60_61, L12_67..L69_70

New LineCode.LC_RESISTIVA   nphases=3  r1=60.7703 x1=3.0947  c1=0  r0=182.3109 x0=9.2841 c0=0  units=km  normamps=100   emergamps=120
! Cabo essencialmente resistivo - CU 4AWG, X/R=0.05
! Representa: L62_63

! ============================================================
!  LINEGEOMETRY
!  Posicoes dos condutores (m) - sistemas de coordenadas OpenDSS:
!   x = posicao horizontal (m), h = altura acima do solo (m)
!  Configuracoes tipicas de torre/poste
! ============================================================

! --- Torre de transmissao AT - tronco principal ---
! Configuracao horizontal simetrica, altura 20-22 m
New LineGeometry.GEO_AT_TRONCO  nconds=3  nphases=3  reduce=no
~ cond=1  wire=CAA_GROSBEAK  x=-4.5  h=20.0  units=m
~ cond=2  wire=CAA_GROSBEAK  x= 0.0  h=21.5  units=m
~ cond=3  wire=CAA_GROSBEAK  x= 4.5  h=20.0  units=m

! --- Torre de ramificacao AT - ramais ---
! Configuracao horizontal mais compacta, altura 18-19 m
New LineGeometry.GEO_AT_RAMAL   nconds=3  nphases=3  reduce=no
~ cond=1  wire=CAA_LINNET  x=-3.5  h=18.0  units=m
~ cond=2  wire=CAA_LINNET  x= 0.0  h=19.5  units=m
~ cond=3  wire=CAA_LINNET  x= 3.5  h=18.0  units=m

! --- Poste MT distribuicao - condutor medio ---
! Configuracao triangular, altura 10-12 m
New LineGeometry.GEO_MT_ALTA_R  nconds=3  nphases=3  reduce=no
~ cond=1  wire=CA_4AWG  x=-1.2  h=10.5  units=m
~ cond=2  wire=CA_4AWG  x= 0.0  h=12.0  units=m
~ cond=3  wire=CA_4AWG  x= 1.2  h=10.5  units=m

! --- Poste MT distribuicao media ---
! Configuracao triangular compacta, altura 9-10.5 m
New LineGeometry.GEO_MT_MEDIO   nconds=3  nphases=3  reduce=no
~ cond=1  wire=CA_2AWG  x=-1.0  h= 9.0  units=m
~ cond=2  wire=CA_2AWG  x= 0.0  h=10.5  units=m
~ cond=3  wire=CA_2AWG  x= 1.0  h= 9.0  units=m

! --- Poste MT ramal leve ---
! Configuracao triangular estreita, altura 8.5-10 m
New LineGeometry.GEO_MT_LEVE    nconds=3  nphases=3  reduce=no
~ cond=1  wire=CA_6AWG  x=-0.8  h= 8.5  units=m
~ cond=2  wire=CA_6AWG  x= 0.0  h=10.0  units=m
~ cond=3  wire=CA_6AWG  x= 0.8  h= 8.5  units=m

! --- Poste BT/MT - R dominante (vertical) ---
! Configuracao vertical tipica de rede de distribuicao, altura 7.5-8.5 m
New LineGeometry.GEO_BT_R_DOM   nconds=3  nphases=3  reduce=no
~ cond=1  wire=CU_2AWG  x= 0.0  h= 8.5  units=m
~ cond=2  wire=CU_2AWG  x= 0.3  h= 8.0  units=m
~ cond=3  wire=CU_2AWG  x= 0.0  h= 7.5  units=m

! --- Ramal resistivo especial ---
New LineGeometry.GEO_RESISTIVA  nconds=3  nphases=3  reduce=no
~ cond=1  wire=CU_4AWG  x=-0.5  h= 7.0  units=m
~ cond=2  wire=CU_4AWG  x= 0.0  h= 7.5  units=m
~ cond=3  wire=CU_4AWG  x= 0.5  h= 7.0  units=m

! --- Barramento rigido ---
New LineGeometry.GEO_BARRAMENTO nconds=3  nphases=3  reduce=no
~ cond=1  wire=CU_BUSBAR  x=-0.5  h= 5.0  units=m
~ cond=2  wire=CU_BUSBAR  x= 0.0  h= 5.0  units=m
~ cond=3  wire=CU_BUSBAR  x= 0.5  h= 5.0  units=m

! ============================================================
!  LINHAS
!  Formato: New Line.Nome  Bus1=  Bus2=
!           ~ LineCode=    Geometry=   Length= (km equivalente)
!
!  O comprimento equivalente e calculado como:
!    Length = R_original / r1_linecode
!  garantindo que r1 * Length = R_total dos dados originais
!
!  Linhas agrupadas por tipo de LineCode
! ============================================================

